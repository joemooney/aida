# Multi-stage build for aida-server
# Supports both x86_64 and ARM64 (Raspberry Pi 5)

FROM docker.io/library/rust:1.85-bookworm AS builder

WORKDIR /app

# Install protobuf compiler
RUN apt-get update && apt-get install -y protobuf-compiler && rm -rf /var/lib/apt/lists/*

# Copy workspace files (5 active crates after the 2026-05-02 desktop/web
# extraction — see /docs/archive/ for what was removed).
COPY Cargo.toml Cargo.lock ./
COPY aida-core ./aida-core
COPY aida-cli ./aida-cli
COPY aida-crate ./aida-crate
COPY aida-server ./aida-server
COPY aida-generate-types ./aida-generate-types
COPY proto ./proto

# Build release binary with postgres feature
RUN cargo build --release --package aida-server --features "postgres"

# Runtime image
FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/aida-server /app/aida-server

# Create store directory
RUN mkdir -p /store

# Configure git for auto-commits inside container
RUN git config --global user.email "aida-server@joemooney.com" && \
    git config --global user.name "AIDA Server"

# Entrypoint script
# - Git store mode (default): uses /store bind-mount
# - If AIDA_DATABASE_URL secret exists: single-project mode (postgres/sqlite)
RUN printf '#!/bin/sh\n\
if [ -f /run/secrets/aida_database_url ]; then\n\
    export AIDA_DATABASE_URL=$(cat /run/secrets/aida_database_url)\n\
    echo "Database mode: using AIDA_DATABASE_URL"\n\
else\n\
    echo "Git store mode: using /store"\n\
fi\n\
exec /app/aida-server "$@"\n' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

ENV RUST_LOG=info

EXPOSE 50051 8080

ENTRYPOINT ["/app/entrypoint.sh"]
# Default: single-project git store at /store
CMD ["--host", "0.0.0.0", "--port", "50051", "--rest-port", "8080", "--database", "/store"]
