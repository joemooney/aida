# Multi-stage build for aida-server
# Supports both x86_64 and ARM64 (Raspberry Pi 5)

FROM docker.io/library/rust:1.85-bookworm AS builder

WORKDIR /app

# Install protobuf compiler
RUN apt-get update && apt-get install -y protobuf-compiler && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY aida-core ./aida-core
COPY aida-cli ./aida-cli
COPY aida-server ./aida-server
COPY aida-desktop ./aida-desktop
COPY aida-web ./aida-web
COPY proto ./proto

# Build release binary with postgres feature
RUN cargo build --release --package aida-server --features "postgres"

# Runtime image
FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/aida-server /app/aida-server

# Create data directory
RUN mkdir -p /data

# Entrypoint script to read secrets and configure mode
# - If AIDA_DATABASE_URL secret exists: single-project mode (legacy)
# - Otherwise: multi-project mode with /data directory
RUN printf '#!/bin/sh\n\
# Read database URL from Docker secret if available (single-project mode)\n\
if [ -f /run/secrets/aida_database_url ]; then\n\
    export AIDA_DATABASE_URL=$(cat /run/secrets/aida_database_url)\n\
    echo "Single-project mode: using AIDA_DATABASE_URL"\n\
else\n\
    echo "Multi-project mode: using /data directory"\n\
fi\n\
exec /app/aida-server "$@"\n' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

ENV RUST_LOG=info

EXPOSE 50051 8080

ENTRYPOINT ["/app/entrypoint.sh"]
# Default to multi-project mode with /data directory
# Override with --database <path> for single-project mode
CMD ["--host", "0.0.0.0", "--port", "50051", "--rest-port", "8080", "--data-dir", "/data"]
