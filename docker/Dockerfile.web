# Multi-stage build for aida-web (WASM client)
# Build stage uses x86_64, runtime is multi-arch nginx

FROM docker.io/library/rust:1.83-bookworm AS builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y protobuf-compiler && rm -rf /var/lib/apt/lists/*

# Install trunk and wasm target
RUN cargo install trunk
RUN rustup target add wasm32-unknown-unknown

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY aida-core ./aida-core
COPY aida-cli ./aida-cli
COPY aida-server ./aida-server
COPY aida-gui ./aida-gui
COPY proto ./proto

# Build WASM client
WORKDIR /app/aida-gui
RUN trunk build --release

# Runtime: lightweight nginx to serve static files
FROM docker.io/library/nginx:alpine

# Copy built WASM files
COPY --from=builder /app/aida-gui/dist /usr/share/nginx/html

# Custom nginx config for SPA routing and proper MIME types
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Proper MIME type for WASM
    types {
        application/wasm wasm;
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/javascript application/wasm;

    # Redirect root to include default server URL
    location = / {
        # If no query params, redirect to include server URL
        if ($args = "") {
            return 302 /?server=https://api.aida.joemooney.com;
        }
        try_files $uri $uri/ /index.html;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|wasm|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
EOF

EXPOSE 80
