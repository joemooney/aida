# Multi-stage build for aida-web (React dashboard)
# Build stage: Node.js + Vite, Runtime: nginx

FROM docker.io/library/node:22-alpine AS builder

WORKDIR /app

# Copy shared types (imported via @shared alias)
COPY shared ./shared

# Copy React dashboard
COPY aida-web-react ./aida-web-react

WORKDIR /app/aida-web-react

# Install dependencies and build
RUN npm ci
RUN npm run build

# Runtime: lightweight nginx to serve static files
FROM docker.io/library/nginx:alpine

# Copy built React app
COPY --from=builder /app/aida-web-react/dist /usr/share/nginx/html

# Custom nginx config for SPA routing and API proxy
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
