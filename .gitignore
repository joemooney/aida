# PostgreSQL data (dev)
.aida/pgdata/
.aida/web-sessions.sqlite3
.aida/server.toml
.aida/.dev-pids/
.aida/.dev-*.log

# AIDA distributed store (orphan branch worktree)
# Pattern matches both the directory (in the canonical worktree) and a
# symlink (in `aida session start`-created sibling worktrees, which
# point back at the canonical store). Without the bare-name pattern,
# git treats the symlink as a tracked file. trace:EPIC-21 | ai:claude
.aida-store/
.aida-store

# AIDA SQLite cache projection (rebuildable from git store)
# trace:EPIC-1-001 | ai:claude
.aida/cache.db
.aida/cache.db-journal
.aida/cache.db-shm
.aida/cache.db-wal

# AIDA runtime state (per-clone, gitignored — must NOT be tracked)
# Session leases (EPIC-20) and role activity logs are local runtime
# state, not project-tracked content. Pattern matches both the directory
# (canonical worktree) AND a symlink (session-worktree siblings).
# trace:BUG-52 | ai:claude
.aida/sessions/
.aida/sessions
.aida/roles/
.aida/roles

# AIDA session environment shim (STORY-52: writes CARGO_TARGET_DIR=<parent>/target
# so session worktrees share the parent's build dir). Generated per-session,
# never committed. Without this entry every post-STORY-52 session-end stumbles
# on BUG-67's untracked-file check and demands --force. trace:BUG-71 | ai:claude
.aida/session-env.sh
