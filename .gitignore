*.sqlite3

# Dispenser/operation lockfiles (transient)
.aida/*.lock

# MCP-server cache snapshots (regenerated each invocation)
.aida/mcp-cache.yaml
.aida/mcp-cache.yaml.lock

# Per-project SQLite cache view (lives here historically due to early
# default_cache_path bug; now lives at the project's .aida/cache.db
# but keep this entry to ensure no stragglers)
.aida/cache.db
.aida/cache.db-journal
.aida/cache.db-shm
.aida/cache.db-wal

# Per-clone dispenser state (sequences are per-node, not project-shared).
# Each clone tracks its own counter; merge-gate handles cross-node ID
# promotion via registry/agreed_counters.toml (shared, tracked).
# trace:EPIC-1-052 Phase 0 | ai:claude
.aida/dispenser.toml

# Per-clone node identity (which node id THIS clone holds). The shared
# entry in registry/nodes.toml is the source of truth; node.toml is just
# the local pointer "I am node N." trace:EPIC-1-052 Phase 1 | ai:claude
.aida/node.toml
