# AIDA Server Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API key for AI chat features
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Enable dev mode (rebuild/restart from Settings UI)
# AIDA_DEV_MODE=true

# Database URL (overrides default discovery)
# AIDA_DATABASE_URL=path/to/requirements.db
