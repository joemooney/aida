#!/usr/bin/env python3
"""Host query proxy for CodeGraph 1.6.0; no seat receives an index write grant.

Install this client as `codegraph` on lane PATH. Run `serve` only on the host,
using the absolute upstream executable, not this wrapper. See README.md.
"""
# trace:STORY-2630 | ai:codex
import argparse
from contextlib import closing
import json
import os
from pathlib import Path
import signal
import socket
import sqlite3
import struct
import subprocess
import sys
import tempfile
import time

MAX_REQUEST = 4096
MAX_OUTPUT = 1024 * 1024
QUERY_TIMEOUT = 15
DESCRIPTOR = "lane-proxy.json"


def validate(request):
    if not isinstance(request, dict):
        raise ValueError("request must be an object")
    op = request.get("op")
    keys = {"op"} if op == "status" else {"op", "symbol", "limit", "depth"}
    if set(request) - keys or op not in ("status", "callers", "callees", "impact"):
        raise ValueError("only callers, callees, impact and status are permitted")
    if op == "status":
        return
    symbol = request.get("symbol")
    if not isinstance(symbol, str) or not 0 < len(symbol) <= 256 or symbol.startswith("-") or any(ord(c) < 32 for c in symbol):
        raise ValueError("invalid symbol")
    for name, default, maximum in (("limit", 20, 100), ("depth", 2, 10)):
        value = request.get(name, default)
        if type(value) is not int or not 1 <= value <= maximum:
            raise ValueError(f"{name} must be an integer from 1 to {maximum}")


def receive(conn, maximum, timeout=QUERY_TIMEOUT + 4):
    deadline = time.monotonic() + timeout
    result = bytearray()
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("proxy message timed out")
        conn.settimeout(remaining)
        chunk = conn.recv(min(65536, maximum + 1 - len(result)))
        if not chunk:
            raise ValueError("incomplete proxy message")
        result.extend(chunk)
        if len(result) > maximum:
            raise ValueError("proxy message exceeds limit")
        if b"\n" in chunk:
            line, rest = result.split(b"\n", 1)
            if rest:
                raise ValueError("one message per connection")
            try:
                return json.loads(line)
            except RecursionError as exc:
                raise ValueError("proxy JSON nesting exceeds limit") from exc


def send(conn, message):
    conn.sendall(json.dumps(message, ensure_ascii=True).encode() + b"\n")


def source_stamp(primary):
    paths = [primary / ".codegraph/codegraph.db", primary / ".codegraph/codegraph.db-wal"]
    result = []
    for index, path in enumerate(paths):
        try:
            stat = path.stat()
            result.append(None if index == 1 and stat.st_size == 0 else
                          (stat.st_ino, stat.st_size, stat.st_mtime_ns))
        except FileNotFoundError:
            result.append(None)
    if result[0] is None:
        raise ValueError("primary codegraph index is missing")
    return result


class Host:
    def __init__(self, primary, state, upstream):
        self.primary = primary.resolve(strict=True)
        self.state = state.resolve(strict=True)
        self.upstream = upstream.resolve(strict=True)
        if not self.upstream.is_file() or not os.access(self.upstream, os.X_OK):
            raise ValueError("upstream must be an absolute executable")
        if self.upstream == Path(__file__).resolve():
            raise ValueError("upstream must be the original CodeGraph executable, not the proxy")
        self.snapshot = None
        self.stamp = None
        self.indexed_at = None
        self.captured_at = None

    def refresh(self):
        lock = self.primary / ".codegraph/codegraph.lock"
        if lock.exists():
            raise ValueError("host reindex lock present; retry after sync")
        stamp = source_stamp(self.primary)
        if stamp == self.stamp:
            return
        # A host-only generation. SQLite backup includes committed WAL pages;
        # copying just the live db bytes would lose them. No immutable live reads.
        generation = tempfile.TemporaryDirectory(prefix="snapshot-", dir=self.state)
        try:
            graph = Path(generation.name) / ".codegraph"
            graph.mkdir()
            source = self.primary / ".codegraph/codegraph.db"
            with closing(sqlite3.connect(source.as_uri() + "?mode=ro", uri=True, timeout=2)) as src:
                with closing(sqlite3.connect(graph / "codegraph.db")) as dst:
                    deadline = time.monotonic() + QUERY_TIMEOUT
                    def progress(*_):
                        if time.monotonic() >= deadline:
                            raise TimeoutError("snapshot backup timed out")
                    src.backup(dst, pages=256, progress=progress, sleep=0.02)
                    dst.execute("SELECT 1 FROM files LIMIT 1").fetchone()
            # A changing source is valid SQLite, but not a settled reindex. Keep
            # the previous generation and retry instead of advertising it as fresh.
            if lock.exists() or stamp != source_stamp(self.primary):
                raise ValueError("primary index changed during backup; retry after host sync")
            indexed_at = max(s[2] for s in stamp if s is not None) / 1e9
            previous = self.snapshot
            self.snapshot = generation
            self.stamp = stamp
            self.indexed_at = indexed_at
            self.captured_at = time.time()
            if previous is not None:
                previous.cleanup()
        except BaseException:
            generation.cleanup()
            raise

    def status(self):
        return {"protocol": 1, "indexed_at": self.indexed_at,
                "captured_at": self.captured_at,
                "snapshot_age_seconds": max(0, int(time.time() - self.indexed_at))}

    def query(self, request):
        validate(request)
        # Status observes the maintained snapshot; it never initiates a backup.
        if request["op"] != "status" or self.snapshot is None:
            self.refresh()
        if request["op"] == "status":
            return {"rc": 0, "output": "", **self.status()}
        op = request["op"]
        argv = [str(self.upstream), op, request["symbol"], "--json", "--path", self.snapshot.name]
        if op == "impact":
            argv += ["--depth", str(request.get("depth", 2))]
        else:
            argv += ["--limit", str(request.get("limit", 20))]
        # The client cannot select argv switches, project, executable or env.
        # Even upstream migration/healing writes reach only the disposable host
        # snapshot, never primary or seat code. No shell or seat config is used.
        env = {"PATH": "/usr/bin:/bin", "HOME": str(self.state), "LANG": "C.UTF-8"}
        with tempfile.TemporaryFile(dir=self.state) as output:
            process = subprocess.Popen(argv, cwd=self.snapshot.name, env=env,
                                       stdin=subprocess.DEVNULL, stdout=output,
                                       stderr=subprocess.STDOUT, start_new_session=True)
            deadline = time.monotonic() + QUERY_TIMEOUT
            try:
                # Observe exit without reaping: retain the group leader PID
                # until killpg so PID reuse cannot target another host group.
                while os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT) is None:
                    if output.tell() > MAX_OUTPUT:
                        raise ValueError("query output exceeds limit")
                    if time.monotonic() >= deadline:
                        raise TimeoutError("codegraph query timed out")
                    time.sleep(0.02)
                if output.tell() > MAX_OUTPUT:
                    raise ValueError("query output exceeds limit")
            finally:
                # Include descendants, even if the original child already exited.
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
            output.seek(0)
            return {"rc": process.returncode, "output": output.read(MAX_OUTPUT).decode("utf-8", errors="replace"), **self.status()}


def write_descriptor(directory, descriptor, data):
    temp_path = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=directory, delete=False) as temp:
            temp_path = Path(temp.name)
            json.dump(data, temp)
            temp.flush()
        os.replace(temp_path, descriptor)
    finally:
        if temp_path is not None:
            temp_path.unlink(missing_ok=True)


def serve(primary, state, upstream):
    host = Host(primary, state, upstream)
    host.refresh()
    directory = host.primary / ".codegraph"
    path = directory / "lane-query.sock"
    descriptor = directory / DESCRIPTOR
    # Refuse existing sockets, including live services. Host removes a stale
    # socket explicitly after checking its owner; never unlink blindly.
    with socket.socket(socket.AF_UNIX) as server:
        server.bind(str(path))
        os.chmod(path, 0o600)
        server.listen(4)
        server.settimeout(1)
        identity = path.stat().st_ino
        try:
            while True:
                # Polling refresh follows every primary sync, including when no
                # lane is querying. A failed refresh leaves the old age visible.
                error = None
                try:
                    host.refresh()
                except (OSError, ValueError, sqlite3.Error, TimeoutError) as exc:
                    error = str(exc)
                data = {**host.status(), "socket": str(path), "observed_at": time.time(), "refresh_error": error}
                write_descriptor(directory, descriptor, data)
                try:
                    conn, _ = server.accept()
                except socket.timeout:
                    continue
                with conn:
                    conn.settimeout(QUERY_TIMEOUT + 2)
                    try:
                        _, uid, _ = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
                        if uid != os.getuid():
                            raise ValueError("foreign proxy peer")
                        result = host.query(receive(conn, MAX_REQUEST, timeout=2))
                    except (OSError, ValueError, sqlite3.Error, TimeoutError) as exc:
                        result = {"rc": 1, "output": f"codegraph proxy: {exc}\n"}
                    try:
                        send(conn, result)
                    except OSError:
                        pass
        finally:
            if path.exists() and path.stat().st_ino == identity:
                path.unlink()
            if host.snapshot is not None:
                host.snapshot.cleanup()


def discover(start):
    for root in [start, *start.parents]:
        descriptor = root / ".codegraph" / DESCRIPTOR
        if descriptor.is_file():
            data = json.loads(descriptor.read_text())
            if data.get("protocol") != 1:
                raise ValueError("unsupported codegraph proxy protocol")
            return str(descriptor.parent.resolve() / "lane-query.sock")
    raise ValueError("no host codegraph proxy; ask the host to deploy it (do not initialize a lane index)")


def client(request, socket_path):
    validate(request)
    with socket.socket(socket.AF_UNIX) as conn:
        conn.settimeout(5)
        conn.connect(socket_path)
        send(conn, request)
        return receive(conn, MAX_OUTPUT * 6 + 4096, timeout=2 * QUERY_TIMEOUT + 5)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest="command", required=True)
    host = subs.add_parser("serve", help="host only: maintain snapshot and serve fixed queries")
    for name in ("primary", "state", "upstream"):
        host.add_argument("--" + name, type=Path, required=True)
    for op in ("callers", "callees", "impact", "status"):
        query = subs.add_parser(op)
        if op != "status":
            query.add_argument("symbol")
            query.add_argument("--limit", "-l", type=int, default=20)
            query.add_argument("--depth", "-d", type=int, default=2)
        query.add_argument("--json", "-j", action="store_true")
        query.add_argument("--path", "-p", type=Path, default=Path.cwd())
    args = parser.parse_args()
    try:
        if args.command == "serve":
            def terminate(_signal, _frame):
                raise SystemExit(0)
            signal.signal(signal.SIGTERM, terminate)
            if not all(p.is_absolute() for p in (args.primary, args.state, args.upstream)):
                raise ValueError("host paths must be absolute")
            serve(args.primary, args.state, args.upstream)
            return 0
        request = {"op": args.command}
        if args.command != "status":
            request.update(symbol=args.symbol, limit=args.limit, depth=args.depth)
        result = client(request, discover(args.path.resolve()))
        if args.command == "status":
            print(json.dumps(result))
        else:
            # Upstream JSON is retained verbatim, including nonzero diagnostics.
            print(result["output"], end="")
        return result["rc"]
    except (OSError, ValueError, KeyError, sqlite3.Error, TimeoutError) as exc:
        print(f"codegraph proxy: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
