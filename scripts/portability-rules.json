[
  {"id": "proc-literal", "label": "proc literal", "regex": "\"[^\"\\n]*/proc/[^\"\\n]*\""},
  {"id": "tmp-literal", "label": "tmp literal", "regex": "\"[^\"\\n]*/tmp[^\"\\n]*\""},
  {"id": "path-separator-join", "label": "PATH separator join", "regex": "\\.join\\(\\s*\":\"\\s*\\)"},
  {"id": "path-separator-split", "label": "PATH separator split", "regex": "\\.split\\(\\s*(?:':'|\":\")\\s*\\)"},
  {"id": "shell-command", "label": "shell command", "regex": "Command::new\\(\\s*\"(?:sh|bash|/bin/sh)\"\\s*\\)"},
  {"id": "prose-classification", "label": "control flow classifies on message text", "scope": "production", "regex": "(?:\\bif\\s|\\|\\||&&)\\s*!?\\(?\\s*(?:[a-z_]*(?:err|error|stderr|stdout|detail|msg|message|reason|output)[a-z_]*|e|lower|m|r|s|out|combined|raw|text)(?:\\.to_string\\(\\)|\\.to_(?:ascii_)?lowercase\\(\\)|\\.as_str\\(\\)|\\.trim\\(\\))*\\.contains\\((?!\\s*')", "context": {"regex": "\\b[a-z_]*(?:err|error|stderr|stdout|detail|msg|message|reason|output|raw)[a-z_]*\\b(?:\\s*:\\s*&(?:str|anyhow::Error)|\\.to_string\\(\\)|\\.to_(?:ascii_)?lowercase\\(\\))|\\b\\w+\\s*:\\s*&(?:anyhow::)?Error\\b|format!\\(\"\\{(?:err|error)[:}]|format!\\(\"\\{e:[#?]|from_utf8_lossy\\(&[\\w.]*std(?:err|out)", "before": 12}, "exempt": "external-prose-classifier:", "self_evident": "\\b[a-z_]*(?:err|error)\\.to_string\\(\\)\\.(?:to_(?:ascii_)?lowercase\\(\\)\\.)?contains\\(", "optout": "//\\s*prose-ok:\\s*\\S"},
  {"id": "toml-path-interpolation", "label": "filesystem path interpolated into a TOML basic string", "regex": "(?:[a-z_]*(?:path|dir|root|worktree)[a-z_]* = \\\\?\"\\{[^}\"]*\\}|\\[[a-z_.]*\\.\\\\?\"\\{[a-z_]*\\})\\\\?\""},
  {"id": "toml-value-interpolation", "label": "value interpolated into a hand-built TOML string (use aida_core::toml_quote::toml_string)", "scope": "production", "regex": "(?:\\b[A-Za-z0-9_.-]+|\\{[A-Za-z0-9_]*\\}) = (?:\\\\\"\\{[^}\"]*\\}\\\\\"|\\{[A-Za-z0-9_.]*:\\?\\})", "optout": "//\\s*toml-ok:\\s*\\S"}
]
