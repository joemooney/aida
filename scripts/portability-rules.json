  {"id": "prose-classification", "label": "control flow classifies on message text", "scope": "production", "regex": "(?:\\bif\\s|\\|\\||&&)\\s*!?\\(?\\s*(?:[a-z_]*(?:err|error|stderr|stdout|detail|msg|message|reason|output)[a-z_]*|e|lower|m|r|s|out|combined|raw|text)(?:\\.to_string\\(\\)|\\.to_(?:ascii_)?lowercase\\(\\)|\\.as_str\\(\\)|\\.trim\\(\\))*\\.contains\\((?!\\s*')", "context": {"regex": "\\b(?:[a-z_]*(?:err|error|stderr|stdout|detail|msg|message|reason|output|raw)[a-z_]*|e)\\b(?:\\s*:\\s*&(?:str|anyhow::Error)|\\.to_string\\(\\)|\\.to_(?:ascii_)?lowercase\\(\\)|\\.contains\\()|format!\\(\\\"\\{(?:e|err|error)[:}]|from_utf8_lossy\\(&[\\w.]*std(?:err|out)", "before": 12}, "exempt": "external-prose-classifier:"}
